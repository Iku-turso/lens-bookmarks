{
  "name": "@k8slens/bookmarks",
  "version": "0.1.0",
  "description": "Bookmark lists and resources of your clusters and web pages under a Bookmarks item in the Lens navigator, and pin them to the hotbar.",
  "keywords": [
    "lens-extension"
  ],
  "author": "Iku-turso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iku-turso/lens-bookmarks.git"
  },
  "bugs": {
    "url": "https://github.com/Iku-turso/lens-bookmarks/issues"
  },
  "homepage": "https://github.com/Iku-turso/lens-bookmarks#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-types-check && lens-package-build --entry-point ./src/index.ts",
    "clean": "rimraf dist/"
  },
  "dependencies": {
    "@k8slens/cluster-contracts": "^2.2.0",
    "@k8slens/command-palette-contracts": "^1.0.2",
    "@k8slens/details-panel-contracts": "^1.1.0",
    "@k8slens/drop-down-menu-contracts": "^2.2.2",
    "@k8slens/drop-down-menu-items": "^1.1.3",
    "@k8slens/electron-contracts": "^1.0.4",
    "@k8slens/element-components": "^3.9.0",
    "@k8slens/feature-core": "^7.5.2",
    "@k8slens/hotbar-contracts": "^2.0.2",
    "@k8slens/icon": "^4.0.0",
    "@k8slens/injectable": "^26.2.1",
    "@k8slens/input-components": "^1.0.1",
    "@k8slens/kube-resource-menu-contracts": "^1.0.2",
    "@k8slens/kubernetes-contracts": "^2.0.2",
    "@k8slens/kubernetes-resources-contracts": "^1.0.0",
    "@k8slens/modal-components": "^1.2.0",
    "@k8slens/modal-contracts": "^1.0.2",
    "@k8slens/navigation-contracts": "^1.0.0",
    "@k8slens/navigator-components": "^1.0.3",
    "@k8slens/navigator-contracts": "^2.0.2",
    "@k8slens/notifications-contracts": "^1.0.2",
    "@k8slens/persistable-contracts": "^1.0.2",
    "@k8slens/stylesheet-contracts": "^1.0.0",
    "@k8slens/use-inject": "^1.0.2",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.0.0",
    "@k8slens/typescript": "^8.0.0",
    "@types/react": "^19.2.0",
    "rimraf": "^4.4.1"
  }
}
